# ─────────────────────────────────────────────
#  .env.example — Copy this to .env and fill in
#  DO NOT put real keys here — this file is safe to commit to git
# ─────────────────────────────────────────────

APP_ENV=development
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=https://jobprotal-kappa.vercel.app
BACKEND_URL=https://job-protal-jbop.onrender.com

ADMIN_EMAIL=admin@jobportal.com
ADMIN_PASSWORD=CHANGE_THIS

DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/jobportal

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://jobprotal-kappa.vercel.app/auth/google/callback

RESEND_API_KEY=YOUR_RESEND_API_KEY
FROM_EMAIL=onboarding@resend.dev

GEMINI_API_KEY=YOUR_GEMINI_API_KEY

RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
